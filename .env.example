# Local infrastructure
CARDIO_OPS_DB_URL=jdbc:postgresql://127.0.0.1:5432/cardio_ops
CARDIO_OPS_DB_USERNAME=cardio_ops
CARDIO_OPS_DB_PASSWORD=local_cardio_ops_only
CARDIO_OPS_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Internal service identities (synthetic local values only)
DEVICE_PLATFORM_MCP_SERVICE_TOKEN=local-demo-mcp-token-change-me
CARDIO_OPS_CUSTOMER_SERVICE_TOKEN=local-demo-bff-token-change-me
CARDIO_OPS_APPROVAL_SERVICE_TOKEN=local-demo-approval-token-change-me

# Agent runtime is opt-in to avoid accidental model charges
CARDIO_OPS_AGENT_ENABLED=false
CARDIO_OPS_MCP_ENABLED=false
CARDIO_OPS_KNOWLEDGE_ENABLED=false
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_EMBEDDING=none
SPRING_AI_VECTOR_STORE_TYPE=none

# Set only when running a real model evaluation
DEEPSEEK_API_KEY=
CARDIO_OPS_EMBEDDING_API_KEY=

